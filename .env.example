# Copie para .env antes de executar vagrant up ou vagrant provision.
# Nunca versione .env: ele pode conter credenciais locais.
DB_NAME=curso_exemplo
DB_USER=root
DB_PASSWORD=vrampp
DB_HOST=127.0.0.1
DB_PORT=3306
DB_EXPOSE=false
DB_REMOTE_USER=vrampp_client
DB_REMOTE_PASSWORD=vrampp-client
VRAMPP_HTTP_PORT=55080
VRAMPP_FTP_PORT=55021
ADMIN_USER=admin
ADMIN_PASSWORD=vrampp-admin

# O MariaDB permanece interno por padrao.
# Para estudar NAT, defina VRAMPP_DB_PORT=55306 no ambiente do host
# e DB_EXPOSE=true no .env. Use o usuario remoto, nunca root, fora da VM.